# Reference service pattern, not an executable deployment script.
# Replace uplink0 and the example subnet after reviewing the actual network.
[Unit]
Description=Internet access for private homelab guests
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c '/usr/sbin/iptables -t nat -C POSTROUTING -s 192.168.50.0/24 -o uplink0 -j MASQUERADE || /usr/sbin/iptables -t nat -A POSTROUTING -s 192.168.50.0/24 -o uplink0 -j MASQUERADE'
ExecStop=/usr/sbin/iptables -t nat -D POSTROUTING -s 192.168.50.0/24 -o uplink0 -j MASQUERADE

[Install]
WantedBy=multi-user.target
